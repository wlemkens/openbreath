.gradle/
build/
local.properties
.idea/
*.iml

# machine-local Claude Code state, not project config
.claude/settings.local.json
.claude/*.tmp.*

# audition candidates stay local; the one the bundled asset is cut from is tracked
media/*
!media/freesound_community-singing-bowl-hit-3-33366.mp3
!media/freesound_community-025535_singing-bowl-60767.mp3

# Signing material. A release key that reaches a remote is compromised and cannot be
# rotated for an already-published app — it must never be committed in the first place.
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties

# Written by generateReleaseNotes from the commit subjects on the way to a publish. Generated,
# so not tracked — and committing it would put yesterday's notes in tomorrow's clone.
app/src/main/play/release-notes/

# Play Developer API service account. Not a signing key, but it can publish to the live app,
# which is close enough — a leaked one lets anyone ship an update to every installed phone.
play-service-account.json

# scratch notes holding credentials. Ignored so that a `git add -A` cannot sweep one into a
# public repository, where a push is not something a later commit can undo.
tmp-creds.md

# generated by xcodegen from iosApp/project.yml — run `xcodegen generate` in iosApp/
*.xcodeproj/
*.xcworkspace/
xcuserdata/
