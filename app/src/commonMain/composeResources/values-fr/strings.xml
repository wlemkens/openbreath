    <string name="welcome_title">Bienvenue</string>
    <string name="welcome_body">Une méditation respiratoire chaque jour, voilà ce que nous conseillerions. Nous pouvons en faire un objectif, et un rappel pour les soirs où cela n’a pas encore eu lieu. Ni l’un ni l’autre n’est nécessaire, et les deux se changent ou s’abandonnent plus tard.</string>
    <string name="welcome_body_goal_only">Une méditation respiratoire chaque jour, voilà ce que nous conseillerions. Nous pouvons en faire un objectif. Ce n’est pas nécessaire, et cela se change ou s’abandonne plus tard.</string>
    <string name="welcome_goal">Un objectif d’une séance par jour</string>
    <string name="welcome_reminder">Un rappel à %1$s si ce n’est toujours pas fait</string>

    <string name="milestone_week">Une semaine</string>
    <string name="milestone_month">Un mois</string>
    <string name="milestone_half_year">Six mois</string>
    <string name="milestone_year">Un an</string>
    <string name="milestone_onwards">En avant</string>
    <string name="milestone_3">Trois jours d’affilée, tout ce que vous vous étiez fixé accompli. C’est ainsi qu’une pratique commence.</string>
    <string name="milestone_7">Une semaine, chaque objectif atteint. Cela commence à tenir.</string>
    <string name="milestone_30">Un mois sans manquer ce que vous vous étiez demandé. Ce n’est plus le hasard.</string>
    <string name="milestone_100">Cent jours. Peu de choses durent aussi longtemps. Celle-ci, oui.</string>
    <string name="milestone_182">Six mois à tenir parole envers vous-même, une respiration à la fois.</string>
    <string name="milestone_365">Un an. Chaque jour, tout ce que vous vous étiez fixé, accompli.</string>
    <string name="milestone_500">Cinq cents jours. Il reste peu à dire.</string>
    <string name="milestone_years">%1$d ans sans interruption.</string>

    <string name="support_title">Soutenir l’app</string>
    <string name="support_p1">OpenBreath est gratuite, et le reste — pas d’essai, pas de déblocage, pas d’abonnement.</string>
    <string name="support_p2">Beaucoup d’applications comme celle-ci se font payer avant même d’être essayées, ou demandent un abonnement annuel. Pour quelque chose qui compte tranquillement votre respiration, cela semble beaucoup demander.</string>
    <string name="support_p3">Il n’y a donc pas de prix ici. Si l’app vous a fait du bien et que le cœur vous en dit, offrez un café, ou plus. Sinon, c’est très bien ainsi — c’est la même app dans les deux cas.</string>
    <string name="support_p4">Ce que vous envoyez va à Wim Lemkens, qui écrit l’app — à lui personnellement, pas à une organisation, et sans contrepartie. Cela ne vous achète rien ici et ne débloque rien, car il n’y a rien à débloquer.</string>
    <string name="support_another">Un autre montant</string>
    <string name="support_note">Ouvre PayPal dans votre navigateur, ou dans l’app PayPal si vous l’avez, en payant directement le développeur. Rien n’est prélevé ici, et l’app n’est pas informée si vous êtes allé au bout.</string>

