<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- lets the app silence notifications for the length of a meditation; the user still
         has to grant policy access from system settings before it does anything -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- the breathing flashlight, which setTorchMode drives without the CAMERA permission.
         Optional: a phone without a flash installs fine and just hides the setting's effect -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- reminders. POST_NOTIFICATIONS is asked for when the first one is made, not on a first
         run; SCHEDULE_EXACT_ALARM is granted from system settings or not at all, and without it
         a reminder falls back to an inexact alarm rather than not arriving -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Backup stays on, deliberately. It is how a practice log survives a new phone, which is
         worth more than the one thing it costs: a restore can put an older copy of the log and
         goals over a fresh install, and the app cannot tell that it happened. Decided knowing
         that; do not turn it off to "protect" the history. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="OpenBreath"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- a reboot clears the alarm table, so the receiver re-arms every reminder from
             storage on BOOT_COMPLETED as well as ringing them -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
