# Copy to keystore.properties and fill in. That file is gitignored and must stay that way:
# a release key that reaches a remote is compromised, and cannot be rotated for an app that
# has already been published.
#
# storeFile is relative to the project root. Keeping the keystore outside the repository
# entirely is safer still — an absolute path works here.
#
# PKCS12 does not support a key password different from the store password; keytool says so
# and ignores the second one. Put the same value in both.
storeFile=breath-upload.p12
storePassword=
keyAlias=upload
keyPassword=
